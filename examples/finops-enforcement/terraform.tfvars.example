# Copy to terraform.tfvars and fill in. (terraform.tfvars is gitignored.)

# account_profile   = "my-account-profile"
# workspace_profile = "my-workspace-profile"
# -- or OAuth SP: account_id + account_host + workspace_host + env creds --

# Sample cost-tag taxonomy (defaults shown; edit freely)
cluster_policy_name = "finops-governed"
required_tag_keys   = ["cost_center", "project"]
allowlist_tags = {
  department = ["ENGINEERING", "FINANCE", "MARKETING", "IT_OPS", "SHARED"]
}

# Serverless usage/budget policy
budget_policy_name = "finops-serverless"
budget_policy_tags = {
  cost_center    = "unassigned"
  project    = "unassigned"
  department = "SHARED"
}

# Legacy single compound-tag model (set true to enforce usage_info instead)
use_legacy_single_tag = false
